# Supabase project URL and public anon key are used by the browser-safe client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app origin used to create allowlisted Auth recovery callback URLs.
# Set this to the deployed CampusBrain origin outside local development.
APP_BASE_URL=http://localhost:3000

# Server-only key. Never prefix this with NEXT_PUBLIC_ or import it into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ byte secret used to sign short lived registration verification tickets.
# Generate locally, for example: openssl rand -base64 48
REGISTRATION_SIGNING_SECRET=

# Separate random 32+ byte key for HMAC-based registration rate-limit identifiers.
# Do not reuse REGISTRATION_SIGNING_SECRET. In PowerShell, generate locally with:
# $bytes = New-Object byte[] 48
# $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
# try { $rng.GetBytes($bytes); $secret = ([BitConverter]::ToString($bytes) -replace '-', '').ToLowerInvariant() } finally { $rng.Dispose() }
# Paste $secret into the empty REGISTRATION_RATE_LIMIT_SECRET entry in .env.local.
# The command assigns it silently; do not print it or commit .env.local.
REGISTRATION_RATE_LIMIT_SECRET=

# The provisioning script promotes an existing Supabase Auth user only after explicit confirmation.
ADMIN_USER_ID=
CONFIRM_ADMIN_PROVISIONING=
